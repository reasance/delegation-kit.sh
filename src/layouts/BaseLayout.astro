---
import '../styles/global.css';
import UmamiAnalytics from '../components/UmamiAnalytics.astro';
import kit from '../data/kit.json';
import catalog from '../data/catalog.json';

const SITE_DESCRIPTION =
  'A model router on your own machine: each request goes to the cheapest of your models that is strong enough for it, and the response says which model answered and why.';

interface PageMeta {
  title?: string;
  description?: string;
  path?: string;
  /** When true, applies `.doc` MDX prose styles to <main> and loads prose.css. */
  doc?: boolean;
}

interface Props extends PageMeta {
  /** Astro injects MDX frontmatter here when this is used as `layout:` in MDX. */
  frontmatter?: PageMeta;
}

const merged: PageMeta = { ...Astro.props, ...Astro.props.frontmatter };
const {
  title = 'delegation-kit — a model router on your own machine',
  description = SITE_DESCRIPTION,
  path = '/',
  doc: isDoc = false
} = merged;

const siteOrigin = Astro.site ?? new URL('https://delegation-kit.sh');
const canonical = new URL(
  path === '/' || path.endsWith('/') ? path : path + '/',
  siteOrigin
).toString();
const ogImage = new URL('/og-image.png', siteOrigin).toString();
const ogAlt =
  'delegation-kit. Easy requests go to your cheap models, hard ones to your strong ones. Every response says which model answered, and why.';

// `wide`: shown from sm up; on a phone the bar keeps one line.
const nav = [
  { href: '/#how', label: 'How it picks', wide: true },
  { href: '/docs/', label: 'Get started', wide: false },
  { href: '/docs/router/', label: 'Router reference', wide: true }
];
/** The page's path with its trailing slash, as the nav links spell it. */
const current = path.endsWith('/') ? path : path + '/';
const navLink =
  'transition-colors duration-300 ease-base hover:text-[var(--color-ink)] aria-[current=page]:text-[var(--color-ink)] aria-[current=page]:font-medium';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="matteoscurati" />
    <meta name="theme-color" content="#eef0f3" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // Scroll reveals and the home page's stories run only when motion is
      // allowed. If the motion script never arrives, show everything.
      if (
        matchMedia('(prefers-reduced-motion: no-preference)').matches &&
        'IntersectionObserver' in window
      ) {
        const html = document.documentElement;
        html.classList.add('motion');
        setTimeout(() => window.__motion || html.classList.remove('motion'), 3000);
      }
    </script>
    {isDoc && <link rel="stylesheet" href="/prose.css" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="delegation-kit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'delegation-kit',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'macOS',
        description: SITE_DESCRIPTION,
        softwareVersion: kit.version,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        url: siteOrigin.href.replace(/\/$/, ''),
        license: 'https://opensource.org/licenses/MIT'
      })}
    />

    <UmamiAnalytics />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:bg-[var(--color-ink)] focus:text-[var(--color-paper)]"
      >Skip to content</a
    >
    <header class="sticky top-0 z-40 px-4 pt-3">
      <nav
        class="max-w-6xl mx-auto h-12 px-4 flex items-center justify-between gap-6 border border-[var(--color-line)] bg-[var(--color-paper)]/80 backdrop-blur-md"
      >
        <a
          href="/"
          class="font-mono font-medium tracking-tight flex items-center gap-2 whitespace-nowrap"
        >
          <span class="inline-block w-2.5 h-2.5 bg-[var(--color-explicit)]" aria-hidden="true"
          ></span>
          delegation-kit
        </a>
        <ul class="flex items-center gap-4 text-sm text-[var(--color-ink-soft)]">
          {
            nav.map((item) => (
              <li class:list={[item.wide && 'hidden sm:block']}>
                <a
                  href={item.href}
                  class={navLink}
                  aria-current={current === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="https://github.com/reasance/delegation-kit"
              class={navLink}
              rel="noopener"
            >
              GitHub ↗
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main" class:list={['max-w-6xl mx-auto px-6', isDoc ? 'doc py-12' : 'py-8']}>
      <slot />
    </main>

    <footer class="border-t border-[var(--color-line-strong)] mt-24">
      <div
        class="max-w-6xl mx-auto px-6 py-8 text-sm text-[var(--color-ink-soft)] flex flex-col sm:flex-row justify-between gap-3"
      >
        <span>
          Code: <a href="https://opensource.org/licenses/MIT" class="hover:text-[var(--color-ink)]"
            >MIT</a
          >
          · <a href="/privacy/" class="hover:text-[var(--color-ink)]">Privacy</a>
          · <a
            href="https://www.npmjs.com/package/delegation-kit"
            class="hover:text-[var(--color-ink)]"
            rel="noopener">npm</a
          >
          · <a href="/changelog/" class="hover:text-[var(--color-ink)]">Changelog</a>
        </span>
        <span class="font-mono">
          v{kit.version} · scores of {catalog.catalogVersion}
        </span>
      </div>
    </footer>
  </body>
</html>
