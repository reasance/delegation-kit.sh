---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import ExampleTable from '../components/ExampleTable.astro';
import LadderChart from '../components/LadderChart.astro';
import kit from '../data/kit.json';
import { hydrogen, flash, opus, pool, fallback, catalogVersion, indexVersion, cuts, examples, rating, priceTag } from '../lib/example-pool';

const models = `${hydrogen.name} (${hydrogen.via}), ${flash.name} (${flash.via}) and ${opus.name} (${opus.via})`;
const heroExamples = [examples[0], examples[2]];

const config = `"router": {
  "decider": { "kind": "llm", "profile": "${flash.id}" },
  "pool": [${pool.map((p) => `"${p.id}"`).join(', ')}],
  "default": "${fallback.id}"
}`;

const app = `from openai import OpenAI

client = OpenAI(base_url="http://127.0.0.1:4141/v1", api_key="unused")
reply = client.chat.completions.create(
    model="auto",
    messages=[{"role": "user", "content": "Rename foo to bar in utils.py"}],
)`;

const link =
  'underline underline-offset-4 decoration-[var(--color-line)] text-[var(--color-ink)] transition-colors duration-300 ease-base hover:decoration-[var(--color-ink)]';
const btn = 'btn inline-block px-3 py-2 text-base font-semibold';
const stepNum = 'font-mono text-[var(--color-ink-soft)] text-sm';
const stepTitle = 'text-xl mt-2 mb-2';
const pickRow = 'border-t border-[var(--color-line)] pt-4 grid gap-2 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-10';
const useRow = 'border-t border-[var(--color-line)] pt-6 grid gap-6 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-10';
---

<BaseLayout path="/">
  <!-- Hero -->
  <section class="pt-10 pb-16 md:pt-16 md:pb-20">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.93fr)_minmax(0,1.07fr)] lg:items-center lg:gap-12">
      <div>
        <h1 class="max-w-2xl text-4xl sm:text-5xl xl:text-[3.5rem] tracking-tight [text-wrap:balance]" data-reveal>
          Easy requests go to your cheap models. Hard ones go to your strong ones.
        </h1>
        <p class="mt-5 max-w-xl text-lg text-[var(--color-ink-soft)]" data-reveal>
          Point your app at one local endpoint. A model you choose rates each request, and the
          cheapest model that meets the minimum answers. Your app can see which model replied and why.
        </p>
        <p class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3" data-reveal>
          <a href="/docs/" class={btn}>Get started →</a>
          <a href="#routing-example" class={link}>See the routing example</a>
        </p>
        <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
          Free and open source under MIT. Runs on your Mac, with your own keys.
        </p>
      </div>
      <figure id="routing-example" class="routing-example scroll-mt-20">
        <header class="routing-heading">
          <h2>Two requests. Two routes.</h2>
          <code>model: auto</code>
        </header>
        <ol role="list" class="routing-samples">
          {heroExamples.map((example) => (
            <li class="routing-sample">
              <p class="routing-request">{example.request}</p>
              <div class="route-reading">
                <div class="route-rating">
                  <div class="rating-marks" aria-hidden="true">
                    {[1, 2, 3, 4].map((level) => (
                      <span class:list={[level <= example.v.difficulty && 'rating-filled']}></span>
                    ))}
                  </div>
                  <p>Rating {rating(example.v)}</p>
                </div>
                <div class="route-choice">
                  <strong>{example.r.chosen.name}</strong>
                  <p><span>~{priceTag(example.r.chosen)}</span> / request</p>
                </div>
              </div>
              <p class="route-reason">{example.why}</p>
            </li>
          ))}
        </ol>
        <figcaption>Illustrative requests. Costs are API price estimates.</figcaption>
      </figure>
    </div>
    <details class="mt-8 border-t border-[var(--color-line)]">
      <summary class="cursor-pointer py-3 underline underline-offset-4">Compare the example pools</summary>
      <div class="mt-4">
        <ExampleTable
          count={3}
          poolIndex={0}
          story
          caption={`Example pool used in the setup below: ${models}.`}
        />
        {
          [1, 2, 3].map((poolIndex) => (
            <details class="mt-3 text-sm">
              <summary class="min-h-11 cursor-pointer py-2 underline underline-offset-4">
                Compare example pool {poolIndex + 1}
              </summary>
              <div class="pt-4">
                <ExampleTable
                  count={3}
                  poolIndex={poolIndex}
                  caption={`Example pool ${poolIndex + 1}. Prices are estimates per request.`}
                />
              </div>
            </details>
          ))
        }
      </div>
    </details>
  </section>

  <!-- How you use it -->
  <section id="use" class="rule pt-16 pb-20 scroll-mt-20">
    <h2 class="text-3xl md:text-4xl mb-3" data-reveal>How you use it</h2>
    <p class="text-[var(--color-ink-soft)] max-w-xl mb-10" data-reveal style="--d: 0.08s">
      Three steps. In your app, only the address and the model name change.
    </p>
    <ol role="list" class="grid gap-10">
      <li class={useRow} data-reveal>
        <div>
          <span class={stepNum} aria-hidden="true">1</span>
          <h3 class={stepTitle}>Install it</h3>
          <p class="text-[var(--color-ink-soft)]">
            Requires macOS, Node.js, jq, git and Python 3. The standard install adds model profiles
            and updates the global Claude Code and Codex instructions. See
            <a href="/docs/#1-install" class={link}>what installation changes</a> before you run it.
          </p>
        </div>
        <CodeBlock
          label="Install and inspect profiles"
          typing
          code={`npx delegation-kit
delegation-config show  # your models`}
        />
      </li>
      <li class={useRow} data-reveal>
        <div>
          <span class={stepNum} aria-hidden="true">2</span>
          <h3 class={stepTitle}>Choose your models and the decider</h3>
          <p class="text-[var(--color-ink-soft)]">
            Name the models the router may pick from, the decider that rates each request, and the model
            that answers when the decider can't. Here: {hydrogen.name}, {flash.name} and {opus.name}.
          </p>
        </div>
        <CodeBlock lang="json" label="~/.config/delegation-kit/config.json, next to “profiles”" code={config} />
      </li>
      <li class={useRow} data-reveal>
        <div>
          <span class={stepNum} aria-hidden="true">3</span>
          <h3 class={stepTitle}>Start it and point your app at it</h3>
          <p class="text-[var(--color-ink-soft)]">
            Anything that uses OpenAI's Chat Completions API works: set the base URL to the router and the
            model to <code class="font-mono text-[0.9em]">"auto"</code>. The answer comes back as usual; its
            <code class="font-mono text-[0.9em]">X-Router-Model</code> header names the model. An agent loop
            that sends <code class="font-mono text-[0.9em]">X-Router-Conversation</code> stays on the model
            its first request got. Claude Code and Codex speak other formats: they can't send their
            requests here, but the router can pick them to answer.
          </p>
        </div>
        <div class="grid gap-4 min-w-0">
          <CodeBlock label="Start the router" code="delegation-router serve" />
          <CodeBlock lang="python" label="Your app (Python, OpenAI SDK)" code={app} />
        </div>
      </li>
    </ol>
    <p class="mt-10" data-reveal>
      <a href="/docs/" class={btn}>Get started, step by step →</a>
    </p>
  </section>

  <!-- How it picks a model -->
  <section id="how" class="rule pt-16 pb-20 scroll-mt-20">
    <h2 class="text-3xl md:text-4xl mb-10" data-reveal>How it picks a model</h2>
    <ol role="list" class="grid gap-8">
      <li class={pickRow} data-reveal>
        <div>
          <span class={stepNum} aria-hidden="true">1</span>
          <h3 class={stepTitle}>Measured efforts get a score</h3>
        </div>
        <p class="text-[var(--color-ink-soft)] max-w-2xl">
          Artificial Analysis publishes a versioned set of model tests. Unmeasured efforts stay unknown. Within 8
          points of the day's best: frontier. Within 20: mid. The rest: small.
        </p>
      </li>
      <li class={pickRow} data-reveal>
        <div>
          <span class={stepNum} aria-hidden="true">2</span>
          <h3 class={stepTitle}>Your decider rates the request</h3>
        </div>
        <p class="text-[var(--color-ink-soft)] max-w-2xl">
          It reads an excerpt, never your keys or your list of models, and answers: how hard is this, 0
          to 4, half points allowed? Code, math, rare knowledge?
        </p>
      </li>
      <li class={pickRow} data-reveal>
        <div>
          <span class={stepNum} aria-hidden="true">3</span>
          <h3 class={stepTitle}>The cheapest one strong enough answers</h3>
        </div>
        <p class="text-[var(--color-ink-soft)] max-w-2xl">
          The rating sets a minimum score: none for 0–1, {cuts.mid} for 2, {cuts.frontier} for 3–4,
          in between for half points. Math or rare knowledge: {cuts.mid} at least. The cheapest of your
          models above it answers; none above? Your strongest. No rating? Your default.
        </p>
      </li>
    </ol>

    <div class="mt-16">
      <p class="eyebrow mb-4" data-reveal>Intelligence Index v{indexVersion} · {catalogVersion}</p>
      <LadderChart />
      <p class="mt-4 max-w-2xl text-[var(--color-ink-soft)]">
        Ringed dots use the efforts in this example; other dots use each model's best measured setting.
        Unmeasured results stay off the chart. The amber line is a request's minimum score: the
        cheapest ringed model at or above it answers. Refresh the scores with your own Artificial
        Analysis key, or set any model's tier yourself.
      </p>
    </div>

    <div class="mt-16">
      <h3 class="text-2xl mb-6" data-reveal>With your three models</h3>
      <ExampleTable
        why
        caption="Costs are the router's estimates at API prices, used to compare models; a model you reach through a subscription is billed by your plan."
      />
    </div>
    <p class="mt-12 flex flex-wrap gap-x-6 gap-y-2">
      <a href="/docs/" class={link}>Get started →</a>
      <a href="/docs/router/" class={link}>Router reference →</a>
    </p>
  </section>

  <section
    id="model-preview"
    aria-labelledby="model-preview-title"
    class="max-w-6xl mx-auto px-6 py-12"
  >
    <p class="eyebrow mb-4">Released v0.38.0 · AA v5.0.1 · November 16, 2026</p>
    <h2 id="model-preview-title" class="text-3xl md:text-4xl mb-6">
      Qwen4 Max, with explicit roles.
    </h2>
    <p class="max-w-2xl mb-5">Qwen4/high is an optional builder, clerk and scout profile on Token Plan. Your existing profiles, router pool, default and decider stay yours. AA reports 42.9 for an unnamed default setting, with no high/xhigh score. <a href="/docs/models/" class="underline">Model evidence →</a></p>
    <p class="max-w-2xl mb-5">
      Fable 5.2/high scores 61.8 and max 64.6. Carbon/high scores 60.0; Hydrogen/high 50.8 and xhigh
      53.9. Each score belongs to that effort. Frontier starts at 56.6 and mid at 44.6.
    </p>
    <p class="max-w-2xl mb-5">
      Hydrogen/medium is a scout, high a builder or reviewer, and xhigh a deeper builder option.
      Carbon/high is an optional judge; Fable 5.2 judgement profiles remain available. Your personal
      router pool, default and decider stay under your control.
    </p>
    <p class="max-w-2xl mb-5">
      Carbon stays optional through Antigravity/agy, requires an enabled Ultra or Enterprise
      account, and must appear under its exact requested ID. It was absent from the checked local
      inventory; Hydrogen was present. No model or API substitution.
    </p>
    <p>
      <a href="/docs/models/" class="underline">Benchmarks and provider limits →</a>
      · <a href="/docs/configuration/" class="underline">Role configuration →</a>
    </p>
    <article
      id="gemini-4-neon"
      aria-labelledby="neon-title"
      class="mt-8 max-w-2xl scroll-mt-20 border-t border-[var(--color-line)] pt-6"
    >
      <p class="eyebrow mb-3">Development preview · current npm release v{kit.version}</p>
      <h3 id="neon-title" class="text-2xl mb-3">Gemini 4 Neon</h3>
      <p class="mb-3">
        The <code>main</code> branch adds the explicit Antigravity profiles <code>neon-builder</code>
        at high and <code>neon-judge</code> at xhigh. Choose a profile for your task and confirm that
        its exact effort ID appears in <code>agy models</code>.
      </p>
      <p>
        Artificial Analysis v5.0.1 measured 59.6 at high and 61.4 at xhigh.
        <a href="https://github.com/reasance/delegation-kit/blob/main/docs/user-configuration.md#google-cli-profiles" class="underline">Neon profile configuration on GitHub →</a>
      </p>
    </article>
  </section>

</BaseLayout>

<script>
  import '../scripts/motion';
</script>

<style>
  .routing-example {
    --route-surface: #212630;
    --route-ink: #f2f4f8;
    --route-soft: #c3ccdc;
    --route-rule: #586478;
    --route-amber: #f2ba61;
    --route-mint: #8be0b2;
    background: var(--route-surface);
    color: var(--route-ink);
    min-width: 0;
    border-radius: 0.875rem;
  }
  .routing-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding: 1.15rem clamp(1rem, 3vw, 1.65rem);
    border-bottom: 1px solid var(--route-rule);
  }
  .routing-heading h2 { font-size: clamp(1.25rem, 2.3vw, 1.55rem); line-height: 1.15; }
  .routing-heading code { color: var(--route-amber); font: 0.8rem/1.4 var(--font-mono); }
  .routing-samples { margin-inline: clamp(1rem, 3vw, 1.65rem); }
  .routing-sample + .routing-sample { border-top: 1px solid var(--route-rule); }
  .routing-sample { padding-block: 1rem; }
  .routing-request { font-weight: 600; line-height: 1.35; margin-bottom: 0.7rem; }
  .route-reading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.16fr);
    align-items: center;
  }
  .route-rating { padding-inline-end: 0.75rem; }
  .route-rating p, .route-choice p, .route-reason, .routing-example figcaption { color: var(--route-soft); font-size: 0.8rem; line-height: 1.45; }
  .rating-marks { display: flex; gap: 0.2rem; width: min(100%, 6.75rem); margin-bottom: 0.3rem; }
  .rating-marks span { flex: 1; height: 0.375rem; background: var(--route-rule); }
  .rating-marks .rating-filled { background: var(--route-amber); }
  .route-choice { border-inline-start: 1px solid var(--route-rule); padding-inline-start: 0.75rem; }
  .route-choice strong { display: block; color: var(--route-mint); font-size: 1rem; line-height: 1.25; }
  .route-choice p { margin-top: 0.2rem; }
  .route-choice p span { font-family: var(--font-mono); }
  .route-reason { margin-top: 0.55rem; text-wrap: pretty; }
  .routing-example figcaption {
    border-top: 1px solid var(--route-rule);
    padding: 0.75rem clamp(1rem, 3vw, 1.65rem);
  }
  /* An ink button: paper text on ink. It lifts to the next dark step on
   * hover and gives a little on press. */
  .btn {
    background: var(--color-ink);
    color: var(--color-paper);
    transition:
      background-color 0.3s var(--ease-base),
      transform 0.3s var(--ease-base);
  }
  .btn:hover {
    background: var(--color-ink-hover);
  }
  .btn:active {
    transform: scale(0.98);
  }

</style>
