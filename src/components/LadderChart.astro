---
// Every scored model in the shipped catalog on one Artificial Analysis
// score axis, split into three tiers by index-bands-v1. The tier lines are
// computed from catalog.json (top_index − frontier_within, top_index −
// mid_within), never written down, so the chart follows every refresh.
// The markup is the final frame. With motion allowed, the chart draws in when
// it scrolls into view, then plays the hero's three requests on it: an amber
// line at each request's minimum score, the models under it dimmed, and the
// cheapest ringed model at or above it pulsing (scripts/motion.ts).
import catalog from '../data/catalog.json';
import { cuts, terra, flash, opus, tiering, examples, cost, indexVersion } from '../lib/example-pool';

type M = { id: string; tier: string | null; index: number | null };
const selected = new Map([terra, flash, opus].map((p) => [p.model, p]));
const dots = (catalog.models as M[])
  .map((m) => selected.has(m.id) ? { ...m, index: selected.get(m.id)!.index, tier: selected.get(m.id)!.tier } : m)
  .filter((m): m is M & { index: number } => typeof m.index === 'number')
  .sort((a, b) => b.index - a.index);
// The frontier example is also the best model of the day: one label for both.
const best = dots[0];
if (best.id !== opus.model || best.index !== cuts.top)
  throw new Error('LadderChart: the copy says the frontier example, Opus 5.5, is the best of the day');

// The copy says Terra clears the mid line; fail the build if a refresh moves it.
if (terra.index < cuts.mid) throw new Error('LadderChart: the copy says Terra clears the mid line');
const over = (terra.index - cuts.mid).toFixed(1);
const unscored = (catalog.models as M[]).filter((m) => typeof m.index !== 'number').map((m) => m.id);
const R = 5.5;

/** Precomputed beeswarm: a dot rises one level when it would touch another. */
function swarm(pos: (i: number) => number) {
  const placed: { p: number; level: number }[] = [];
  return dots.map((m) => {
    const p = pos(m.index);
    let level = 0;
    while (placed.some((q) => q.level === level && Math.abs(q.p - p) < 2 * R + 1)) level++;
    placed.push({ p, level });
    return { m, p, level };
  });
}

// desktop: index on x
const X = (i: number) => 40 + (i / 60) * 880;
const AX = 170;
const hd = swarm(X).map((d) => ({ ...d, cx: d.p, cy: AX - 12 - d.level * 12 }));
// vertical: index on y
const Yv = (i: number) => 490 - i * 7.6;
const vd = swarm(Yv).map((d) => ({ ...d, cx: 70 + d.level * 12, cy: d.p }));

// The three example models are ringed and named.
const pool = new Set([terra.model, flash.model, opus.model]);
const named = pool;
const at = (list: typeof hd, id: string) => list.find((d) => d.m.id === id)!;

const f = cuts.frontier;
const md = cuts.mid;
const ticks = [0, 10, 20, 30, 40, 50, 60];
const n = dots.length;

// The story's data: the hero's three requests, and the ringed models by price.
const beats = examples.slice(0, 3).map((x) => ({
  rated: ['Rated ' + x.v.difficulty + ' of 4', ...x.v.tags].join(' · '),
  min: x.r.minimum ?? 0
}));
const storyPool = [terra, flash, opus]
  .map((p) => ({ id: p.model, name: p.name, index: p.index, cost: cost(p) }))
  .sort((a, b) => a.cost - b.cost);
const story = JSON.stringify({ beats, pool: storyPool });
// Dots draw in left to right (bottom to top on a phone), lowest score first.
const order = new Map([...dots].reverse().map((m, k) => [m.id, k]));
const delay = (id: string) => `--d: ${(0.3 + order.get(id)! * 0.02).toFixed(2)}s`;

const css = `
.lc .band-f{fill:var(--color-ink);fill-opacity:.075}
.lc .band-m{fill:var(--color-ink);fill-opacity:.035}
.lc .bandname{font-size:11px;letter-spacing:.02em;fill:var(--color-ink-soft)}
.lc .axis{stroke:var(--color-ink);stroke-width:1.25}
.lc .tick{stroke:var(--color-ink);stroke-width:1}
.lc .best{stroke:var(--color-ink);stroke-width:2}
.lc .cut{stroke:var(--color-ink);stroke-width:1;stroke-dasharray:4 4}
.lc .dot{fill:var(--color-ink-soft)}
.lc .dot-pool{fill:var(--color-ink)}
.lc .ring{fill:none;stroke:var(--color-ink);stroke-width:1.25}
.lc .leader{fill:none;stroke:var(--color-ink-soft);stroke-width:.75}
.lc .halo{paint-order:stroke;stroke:var(--color-paper);stroke-width:4px;stroke-linejoin:round}
.lc .b{font-weight:500}
.lc .floor{stroke:var(--color-explicit-strong);stroke-width:2}
.lc .cap{fill:var(--color-explicit-text)}
.lc .pulse{fill:none;stroke:var(--color-ink);stroke-width:1.25;opacity:0;transform-box:fill-box;transform-origin:center}
.lc .st{opacity:0}
.lc .pv{transition:opacity .3s var(--ease-base)}
.lc .pv.dim{opacity:.2}
.motion .lc .pt{transition:opacity .75s var(--e2),filter .75s var(--e2),transform 1.05s var(--e);transition-delay:var(--d);transform-box:fill-box;transform-origin:center}
.motion .lc svg:not(.is-in) .pt{opacity:0;filter:blur(4px);transform:scale(.85)}
.motion .lc .axis{stroke-dasharray:1;transition:stroke-dashoffset 1.1s var(--io)}
.motion .lc svg:not(.is-in) .axis{stroke-dashoffset:1}
.motion .lc .fx{transition:opacity .75s var(--e2);transition-delay:var(--d)}
.motion .lc svg:not(.is-in) .fx{opacity:0}
.lc-m{display:block;max-width:26rem}
.lc-m text{font-size:13px}
.lc-m .sm{font-size:12px}
.lc-m .bandname{font-size:12px}
.lc-d{display:none}
@media (min-width:1024px){.lc-d{display:block}.lc-m{display:none}}
`;
const desc = `Artificial Analysis Intelligence Index v${indexVersion} scores from 0 to 60 on ${catalog.catalogVersion}, one dot per model, using the example effort for ringed models and the best measured setting for other models. The best score of the day is ${opus.name} at ${cuts.top}. Within ${tiering.frontier_within} points of it (${f} and up): frontier, the strongest tier. Within ${tiering.mid_within} points (${md} and up): mid. Below: small. The three models in the examples: ${opus.name} is frontier, ${flash.name} (${flash.index}) is small; ${terra.name} (${terra.index}) is mid, ${over} above the mid line.`;
const title = (d: (typeof hd)[number]) => `${d.m.id} · ${d.m.index.toFixed(1)} · ${d.m.tier}`;
---

<style set:html={css}></style>

<div class="lc">
  <svg
    class="dg lc-d"
    viewBox="0 0 960 256"
    role="img"
    aria-labelledby="lc-t lc-desc"
    data-story="ladder"
    data-axis="x"
    data-o={X(0)}
    data-k={X(1) - X(0)}
    data-model={story}
  >
    <title id="lc-t">Artificial Analysis scores, split into three tiers</title>
    <desc id="lc-desc">{desc}</desc>
    <g class="fx" style="--d: 0.15s">
      <rect x={X(md)} y="24" width={X(f) - X(md)} height={AX - 24} class="band-m"></rect>
      <rect x={X(f)} y="24" width={X(60) - X(f)} height={AX - 24} class="band-f"></rect>
      <text x="48" y="42" class="bandname">small</text>
      <text x={X(md) + 8} y="42" class="bandname">mid</text>
      <text x={X(f) + 8} y="42" class="bandname">frontier</text>
      <path d={`M${X(f)} 24 V${AX} M${X(md)} 24 V${AX}`} class="cut"></path>
      <text x={X(f)} y="206" class="mid b sm">{f.toFixed(1)}</text>
      <text x={X(md)} y="206" class="mid b sm">{md.toFixed(1)}</text>
    </g>
    <path d={`M40 ${AX} H${X(60)}`} pathLength="1" class="axis"></path>
    {
      ticks.map((t) => (
        <g class="fx" style="--d: 0.3s">
          <path d={`M${X(t)} ${AX} V${AX + 5}`} class="tick" />
          <text x={X(t)} y="188" class="mid sm soft">
            {t}
          </text>
        </g>
      ))
    }
    <path d={`M${X(cuts.top)} ${AX} V100`} class="best fx" style="--d: 1.1s"></path>
    <g class="fx" style="--d: 1.2s">
      <path d={`M${X(cuts.top)} 226 H${X(f)}`} class="cut"></path>
      <text x={(X(cuts.top) + X(f)) / 2} y="230" class="mid sm halo">{tiering.frontier_within} points</text>
    </g>
    <g class="fx" style="--d: 1.25s">
      <path d={`M${X(cuts.top)} 246 H${X(md)}`} class="cut"></path>
      <text x={(X(cuts.top) + X(md)) / 2} y="250" class="mid sm halo">{tiering.mid_within} points</text>
    </g>
    <g class="st" aria-hidden="true">
      <path d={`M0 24 V${AX}`} class="floor"></path>
    </g>
    {
      hd.map((d) => (
        <g class="pt" style={delay(d.m.id)} data-i={d.m.index}>
          <title>{title(d)}</title>
          <g class="pv">
            <circle cx={d.cx} cy={d.cy} r={R} class={pool.has(d.m.id) ? 'dot-pool' : 'dot'} />
            {pool.has(d.m.id) && <circle cx={d.cx} cy={d.cy} r={R + 3.5} class="ring" />}
          </g>
          {pool.has(d.m.id) && <circle cx={d.cx} cy={d.cy} r={R + 3.5} class="pulse" data-pulse={d.m.id} />}
        </g>
      ))
    }
    <g class="st" aria-hidden="true">
      <text x="40" y="230" class="sm cap b" data-cap="rated"></text>
      <text x="40" y="248" class="sm" data-cap="pick"></text>
    </g>
    <g class="fx" style="--d: 1.3s">
      <text x="916" y="60" class="end b">{opus.name}</text>
      <text x="916" y="76" class="end sm">{opus.index.toFixed(1)}</text>
      <text x="916" y="92" class="end sm">best of the day</text>
      <path d={`M${at(hd, flash.model).cx} ${at(hd, flash.model).cy - 10} V80`} class="leader"></path>
      <text x={at(hd, flash.model).cx - 6} y="58" class="b">{flash.name}</text>
      <text x={at(hd, flash.model).cx - 6} y="74" class="sm">{flash.index.toFixed(1)}</text>
      <path d={`M${at(hd, terra.model).cx} ${at(hd, terra.model).cy - 7} V96`} class="leader"></path>
      <text x={at(hd, terra.model).cx - 7} y="104" class="end b halo">{terra.name}</text>
      <text x={at(hd, terra.model).cx - 7} y="118" class="end sm soft halo">{terra.index.toFixed(1)}, {over} above mid</text>
    </g>
  </svg>

  <svg
    class="dg lc-m"
    viewBox="0 0 360 510"
    role="img"
    aria-labelledby="lc-tm lc-descm"
    data-story="ladder"
    data-axis="y"
    data-o={Yv(0)}
    data-k={Yv(1) - Yv(0)}
    data-model={story}
  >
    <title id="lc-tm">Artificial Analysis scores, split into three tiers</title>
    <desc id="lc-descm">{desc}</desc>
    <g class="fx" style="--d: 0.15s">
      <rect x="56" y={Yv(f)} width="296" height={Yv(md) - Yv(f)} class="band-m"></rect>
      <rect x="56" y={Yv(60)} width="296" height={Yv(f) - Yv(60)} class="band-f"></rect>
      <text x="346" y={Yv(f) - 6} class="end bandname">frontier · {f.toFixed(1)}</text>
      <text x="346" y={Yv(md) - 6} class="end bandname">mid · {md.toFixed(1)}</text>
      <text x="346" y={Yv(md) + 16} class="end bandname">small</text>
      <path d={`M56 ${Yv(f)} H352 M56 ${Yv(md)} H352`} class="cut"></path>
    </g>
    <path d={`M56 ${Yv(0)} V${Yv(60)}`} pathLength="1" class="axis"></path>
    {
      ticks.map((t) => (
        <g class="fx" style="--d: 0.3s">
          <path d={`M51 ${Yv(t)} H56`} class="tick" />
          <text x="48" y={Yv(t) + 4} class="end sm soft">
            {t}
          </text>
        </g>
      ))
    }
    <g class="st" aria-hidden="true">
      <path d="M56 0 H352" class="floor"></path>
    </g>
    {
      vd.map((d) => (
        <g class="pt" style={delay(d.m.id)} data-i={d.m.index}>
          <title>{title(d)}</title>
          <g class="pv">
            <circle cx={d.cx} cy={d.cy} r={R} class={pool.has(d.m.id) ? 'dot-pool' : 'dot'} />
            {pool.has(d.m.id) && <circle cx={d.cx} cy={d.cy} r={R + 3.5} class="ring" />}
          </g>
          {pool.has(d.m.id) && <circle cx={d.cx} cy={d.cy} r={R + 3.5} class="pulse" data-pulse={d.m.id} />}
        </g>
      ))
    }
    <g class="st" aria-hidden="true">
      <text x="130" y="444" class="cap b" data-cap="rated"></text>
      <text x="130" y="462" data-cap="pick"></text>
    </g>
    <g class="fx" style="--d: 1.3s">
      {
        vd
          .filter((d) => named.has(d.m.id))
          .map((d) =>
            d.m.id === terra.model ? (
              <path d={`M${d.cx + 7} ${d.cy} H112 V${d.cy + 14} H124`} class="leader" />
            ) : (
              <path d={`M${d.cx + 9} ${d.cy} H124`} class="leader" />
            )
          )
      }
      <text x="130" y={at(vd, opus.model).cy + 4} class="b">{opus.name} {opus.index.toFixed(1)}</text>
      <text x="130" y={at(vd, opus.model).cy + 18} class="sm soft">best of the day</text>
      <text x="130" y={at(vd, flash.model).cy + 4} class="b">{flash.name} {flash.index.toFixed(1)}</text>
      <text x="130" y={at(vd, terra.model).cy + 18} class="b">{terra.name} {terra.index.toFixed(1)}</text>
      <text x="130" y={at(vd, terra.model).cy + 32} class="sm soft">mid: {over} above the line</text>
    </g>
  </svg>
  <p class="sr-only">{n} models plotted{unscored.length ? `; ${unscored.join(', ')} ${unscored.length === 1 ? 'has' : 'have'} no score yet` : ''}.</p>
</div>
