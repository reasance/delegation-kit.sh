---
interface Props {
  code: string;
  lang?: string;
  /** Optional caption rendered above the block, e.g. the command's role. */
  label?: string;
  /** Home page story: the command deletes and retypes itself (scripts/motion.ts). */
  typing?: boolean;
}
const { code, lang = 'sh', label, typing = false } = Astro.props;
// `cb-wrap` is the layout hook prose.css uses for vertical rhythm.
---

<div class="cb-wrap min-w-0">
  <div class="mb-2 flex min-w-0 items-center gap-3">
    {
      label && (
        <p class="min-w-0 font-mono text-xs text-[var(--color-ink-soft)] [overflow-wrap:anywhere]">
          {label}
        </p>
      )
    }
    <button
      type="button"
      class="ml-auto min-h-11 shrink-0 border border-[var(--color-line-strong)] px-3 font-mono text-xs text-[var(--color-ink)]"
      data-copy={code}
      aria-label={label ? `Copy: ${label}` : 'Copy code to clipboard'}>Copy</button
    >
  </div>
  <div class="relative group" data-reveal={typing ? 'up' : undefined}>
    <pre
      tabindex="0"
      role="region"
      aria-label={label ?? 'Code example'}
      data-story={typing ? 'type' : undefined}
      class="relative bg-[var(--color-ink)] text-[var(--color-paper)] px-4 py-3 overflow-x-auto text-sm leading-relaxed w-full"><code data-lang={lang}>{code}</code></pre>
  </div>
  <p class="text-xs empty:m-0" role="status" data-copy-status></p>
</div>

<style>
  /* The typing story draws over the real code, which stays in place (and in
   * the accessibility tree) so the block never changes size. */
  :global(.type-ghost) {
    position: absolute;
    inset: 0;
    padding: inherit;
    margin: 0;
    pointer-events: none;
    white-space: pre;
  }
  :global(.type-caret) {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    margin-left: 1px;
    vertical-align: -0.2em;
    background: var(--color-explicit);
  }
</style>

<script>
  const timers = new WeakMap<HTMLButtonElement, ReturnType<typeof setTimeout>>();
  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest<HTMLButtonElement>('button[data-copy]');
    if (!button) return;
    const status = button.closest('.cb-wrap')?.querySelector('[data-copy-status]');
    const previous = timers.get(button);
    if (previous) clearTimeout(previous);
    if (status) status.textContent = '';
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.textContent = 'Copied';
      if (status) status.textContent = 'Code copied to the clipboard.';
    } catch {
      button.textContent = 'Copy';
      if (status)
        status.textContent = 'Clipboard unavailable. Select the code and copy it manually.';
      return;
    }
    timers.set(
      button,
      setTimeout(() => {
        button.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2200)
    );
  });
</script>
